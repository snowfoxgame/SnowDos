<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <package android:name="com.snowsplit.app" />
    </queries>

    <permission
        android:name="com.snowapps.permission.THEME_SYNC"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.snowapps.permission.THEME_SYNC" />

    <application
        android:name=".SnowDosApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_normal"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_normal"
        android:supportsRtl="true"
        android:theme="@style/Theme.SnowDos">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.SnowDos" />

        <activity-alias
            android:name=".MainActivityNormal"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_normal"
            android:roundIcon="@mipmap/ic_launcher_normal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityWinter"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_winter"
            android:roundIcon="@mipmap/ic_launcher_winter"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityHalloween"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_halloween"
            android:roundIcon="@mipmap/ic_launcher_halloween"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityChristmas"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_christmas"
            android:roundIcon="@mipmap/ic_launcher_christmas"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivitySummer"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_summer"
            android:roundIcon="@mipmap/ic_launcher_summer"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityAutumn"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_autumn"
            android:roundIcon="@mipmap/ic_launcher_autumn"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivitySpring"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_spring"
            android:roundIcon="@mipmap/ic_launcher_spring"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityEaster"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_easter"
            android:roundIcon="@mipmap/ic_launcher_easter"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainActivityNewYear"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_new_year"
            android:roundIcon="@mipmap/ic_launcher_new_year"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".platform.alarm.ReminderAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SnowDos" />

        <receiver
            android:name=".platform.alarm.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".platform.alarm.NotificationActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".platform.alarm.BootCompletedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name=".feature.widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.SnowDos">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".feature.widget.SnowDosTasksWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_tasks_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/snowdos_tasks_widget_info" />
        </receiver>

        <provider
            android:name=".platform.sync.ThemeSyncContentProvider"
            android:authorities="${applicationId}.syncprovider"
            android:exported="true"
            android:permission="com.snowapps.permission.THEME_SYNC" />

        <receiver
            android:name=".platform.sync.ThemeSyncReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="com.snowapps.permission.THEME_SYNC">
            <intent-filter>
                <action android:name="com.snowapps.action.APPEARANCE_SYNC" />
            </intent-filter>
        </receiver>

        <!-- Custom WorkManager initialization for HiltWorkerFactory -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
